# Copy relevant lines into your shell session (or a local .env you source
# yourself -- this project reads plain os.environ, no dotenv dependency)
# to override any of these. Every value shown here is already the default,
# so an unmodified copy changes nothing.

# --- Log source switch (core/config.py) ---------------------------------
# "csv"   -- live_analyzer.py tails data/live/college_site_access.csv,
#            written directly by the Flask demo site. Zero setup.
# "nginx" -- live_analyzer.py tails NGINX's access.log instead, with
#            NGINX reverse-proxying the same Flask app. See docs/NGINX_SETUP.md.
LOG_SOURCE=csv

# --- Ports / hosts (core/config.py) --------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
NGINX_PORT=80

# --- Log file paths -------------------------------------------------------
# Path NGINX writes its access log to (core/config.py). Relative paths
# are resolved against the repo root when live_analyzer.py reads them.
NGINX_ACCESS_LOG_PATH=nginx/logs/access.log

# Overrides whichever of the two paths above LOG_SOURCE would otherwise
# select -- e.g. to point live_analyzer.py at the training corpus instead
# (core/paths.py).
# LIVE_LOG_PATH=data/live/college_site_access.csv

# Where site/app.py itself writes its CSV access log (core/paths.py /
# core/paths.py's LIVE_ACCESS_LOG_PATH, joined with the repo root).
# COLLEGE_SITE_LOG_PATH=

# Overrides the URL demo/*.py attack scripts send traffic to (normally
# computed automatically from LOG_SOURCE + FLASK_PORT/NGINX_PORT above).
# DEMO_BASE_URL=

decision_stats.json

# Demo college website's live access log (regenerated by site/app.py;
# kept separate from the training dataset on purpose). logs/ is the old
# location, kept for backward compatibility; data/live/ is the current one.
logs/*.csv
data/live/*.csv

# Ad-hoc/synthetic output (Project_Files/log_generator.py default target) --
# never the canonical training/testing datasets, which ARE tracked.
data/archive/*.csv

# Python cache folders anywhere
**/__pycache__/

